{
  "expo": {
    "name": "Eduka",
    "slug": "Eduka",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Eduka"
    },
    "web": {},
    "plugins": [
      "expo-secure-store",
      "@react-native-vector-icons/fontawesome-free-solid",
      "@react-native-vector-icons/evil-icons"
    ]
  }
}
